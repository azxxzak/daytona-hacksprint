{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.py": {
      "maxDuration": 300,
      "excludeFiles": "{frontend,samples,data,cache,reports,docs,scripts,node_modules,.venv}/**"
    }
  },
  "regions": [
    "hnd1"
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/api/index"
    }
  ]
}