# Copy to .env (never commit .env)
# Get the key at https://app.daytona.io -> API Keys
DAYTONA_API_KEY=
ANTHROPIC_API_KEY=

# Sign-in (pick one). Shared password:
APP_PASSWORD=
# Or Google sign-in: fill .streamlit/secrets.toml (see .streamlit/secrets.toml.example) and allow people:
ALLOWED_EMAILS=
ALLOWED_DOMAINS=
